<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="EsBattagliaNavale.Insert">
      <StackPanel>
        <TextBlock x:Name="TxtIstruzioni" Text="Posiziona le navi"/>
        <CheckBox x:Name="ChkOrizzontale" Content="Orizzontale" IsChecked="True"/>
        <UniformGrid x:Name="GrigliaCampo" Rows="10" Columns="10" Width="300" Height="300"/>
        <Button x:Name="BtnConferma" Content="Conferma Navi" IsEnabled="False" Click="OnClickConferma"/>
    </StackPanel>
</UserControl>
